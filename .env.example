# ── Server only ────────────────────────────────────────────────
# Read only by API routes and src/lib/auth.ts, src/db/index.ts.
# Never prefixed EXPO_PUBLIC_ — these must never reach the bundle.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Where the Better Auth handler is reachable. Must match EXPO_PUBLIC_API_URL in dev.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Client ─────────────────────────────────────────────────────
# EXPO_PUBLIC_* is inlined into the JS bundle at build time.
# Assume it is public: no secrets, and changing it needs a rebuild.
EXPO_PUBLIC_API_URL=

# ── OAuth Credentials ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
